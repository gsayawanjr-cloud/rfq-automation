# Copy to .env and fill in. Never commit .env.

# ─── Trigger.dev ───────────────────────────────────────────────
# cloud.trigger.dev → THIS project (one Trigger.dev project per automation) → API Keys → Development secret key (tr_dev_...)
TRIGGER_SECRET_KEY=

# ─── Anthropic / Claude ───────────────────────────────────────
# console.anthropic.com → Settings → API Keys (sk-ant-...)
ANTHROPIC_API_KEY=
# Only for org-level keys (error: "not scoped to a workspace"): Settings → Workspaces → workspace ID (wrkspc_...)
ANTHROPIC_WORKSPACE_ID=

# ─── Gmail inbox ──────────────────────────────────────────────
# Gmail → Settings → Forwarding and POP/IMAP → enable IMAP
RFQ_GMAIL_USER=
# myaccount.google.com/apppasswords (needs 2-Step Verification). 16 characters.
RFQ_GMAIL_APP_PASSWORD=
# Extra Gmail filter, added to the always-on base "in:inbox -label:<processed> newer_than:2d". Default: -from:me
# Local testing: subject:TEST-RFQ (lets self-sent tests through)
RFQ_GMAIL_QUERY=subject:TEST-RFQ
# Uploaded as RFQ_GMAIL_QUERY on a production deploy (see trigger.config.ts).
RFQ_GMAIL_QUERY_PRODUCTION=-from:me subject:(RFQ OR quote OR quotation OR enquiry OR inquiry OR spares OR requisition OR viber)

# ─── Google Sheet ─────────────────────────────────────────────
# Google Cloud → IAM → Service Accounts → Keys → Add key (JSON). The WHOLE JSON on one line (not the account email).
# Enable the Sheets API, and share the sheet with the service account's client_email as Editor.
GOOGLE_SERVICE_ACCOUNT_JSON=
# docs.google.com/spreadsheets/d/<THIS PART>/edit
RFQ_SHEET_ID=
# Tab name; created and formatted automatically if missing.
RFQ_SHEET_TAB=RFQs

# ─── Draft reply signature ────────────────────────────────────
SALES_REP_NAME=
# Optional, for example Sales Manager. Shown under the name in every signature.
SALES_REP_TITLE=
COMPANY_NAME=

# --- Claude model (optional) ---
# Default claude-opus-5-5. claude-sonnet-5-5 gave the same results on the hardest sample at ~40% of the cost.
# Test emails sent from the inbox to itself may also add [model:<id>] to the subject to pick a model per email.
RFQ_MODEL=claude-sonnet-5-5

# --- Mail provider: gmail (default) or outlook (Microsoft 365, see OUTLOOK_SETUP.md) ---
MAIL_PROVIDER=gmail
# Outlook only:
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_MAILBOX=
RFQ_OUTLOOK_SUBJECT_KEYWORDS=RFQ,quote,quotation,enquiry,inquiry,spares,requisition,viber
# Local testing only (never uploaded): also process mail sent from the mailbox to itself.
RFQ_OUTLOOK_INCLUDE_SELF=

# --- Alerts (failures, credits, stuck mail) ---
# Where alert emails go. Repeats at most once per problem every 6 hours.
ALERT_EMAIL_TO=
# Optional separate Gmail sender so alerts still work when the agent's own mailbox login is the problem.
ALERT_GMAIL_USER=
ALERT_GMAIL_APP_PASSWORD=
# Optional early low-credit warning (an estimate from token counts; Anthropic has no balance API):
# credits loaded in USD, and the date (YYYY-MM-DD) they were loaded. Warns at 80% used.
ANTHROPIC_CREDIT_USD=
CREDIT_COUNT_FROM=

# --- Cloud switch ---
# true = deploy with the schedules doing nothing; false = deploy live. Required before deploying.
RFQ_PAUSED_PRODUCTION=true

# --- Business settings (per client). Defaults keep the original wording. ---
# Currency on quotations, orders and sheet column headers. Set it BEFORE first use.
CURRENCY=USD
QUOTE_VALIDITY_DAYS=30
PAYMENT_TERMS=30 days from invoice date
PRICE_BASIS=ex-works our warehouse, excluding taxes and duties
# Delivery line on quotations (this client's delivery charges). Leave empty and quotations have no delivery line.
TERMS_DELIVERY=
TERMS_AVAILABILITY=
# More terms, separated by |
EXTRA_TERMS=
# Quotation PDF letterhead
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_WEBSITE=
COMPANY_TAX_ID=
# Public PNG or JPEG under 1 MB (https address or a data: URL)
COMPANY_LOGO_URL=
# Payment details on the PDF, one line per | separator
BANK_DETAILS=
# true: a person approves each order in the Orders tab before stock changes. false: stock drops automatically.
ORDER_APPROVAL=true
# Reminder drafts for customers who have not answered
REMINDER_DAYS_CONFIRMATION=2
REMINDER_DAYS_QUOTATION=3
MAX_REMINDERS=2
